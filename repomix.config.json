{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 52428800
  },
  "output": {
    "filePath": "llvm-lld.md",
    "style": "markdown",
    "parsableStyle": false,
    "fileSummary": false,
    "directoryStructure": false,
    "files": true,
    "removeComments": true,
    "removeEmptyLines": true,
    "compress": false,
    "topFilesLength": 5,
    "showLineNumbers": false,
    "truncateBase64": false,
    "copyToClipboard": false,
    "includeFullDirectoryStructure": false,
    "tokenCountTree": false,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 100,
      "includeDiffs": false,
      "includeLogs": false,
      "includeLogsCount": 50
    }
  },
  "include": [
    "lld/COFF/Chunks.cpp",
    "lld/COFF/Chunks.h",
    "lld/COFF/COFFLinkerContext.cpp",
    "lld/COFF/COFFLinkerContext.h",
    "lld/COFF/Config.h",
    "lld/COFF/DebugTypes.cpp",
    "lld/COFF/DebugTypes.h",
    "lld/COFF/DLL.cpp",
    "lld/COFF/DLL.h",
    "lld/COFF/Driver.cpp",
    "lld/COFF/Driver.h",
    "lld/COFF/DriverUtils.cpp",
    "lld/COFF/ICF.cpp",
    "lld/COFF/ICF.h",
    "lld/COFF/Incremental.cpp",
    "lld/COFF/Incremental.h",
    "lld/COFF/IncrementalLayout.cpp",
    "lld/COFF/IncrementalLayout.h",
    "lld/COFF/IncrementalRedirects.cpp",
    "lld/COFF/IncrementalRedirects.h",
    "lld/COFF/IncrementalState.cpp",
    "lld/COFF/IncrementalState.h",
    "lld/COFF/InputFiles.cpp",
    "lld/COFF/InputFiles.h",
    "lld/COFF/LTO.cpp",
    "lld/COFF/LTO.h",
    "lld/COFF/MarkLive.cpp",
    "lld/COFF/MarkLive.h",
    "lld/COFF/PDB.cpp",
    "lld/COFF/PDB.h",
    "lld/COFF/Symbols.cpp",
    "lld/COFF/Symbols.h",
    "lld/COFF/SymbolTable.cpp",
    "lld/COFF/SymbolTable.h",
    "lld/COFF/TypeMerger.h",
    "lld/COFF/Writer.cpp",
    "lld/COFF/Writer.h",
    "llvm/include/llvm/BinaryFormat/COFF.h",
    "llvm/include/llvm/DebugInfo/CodeView/CodeView.h",
    "llvm/include/llvm/DebugInfo/CodeView/SymbolRecord.h",
    "llvm/include/llvm/DebugInfo/PDB/Native/DbiStream.h",
    "llvm/include/llvm/DebugInfo/PDB/Native/RawTypes.h",
    "lld/unittests/COFF/IncrementalStateTests.cpp"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": []
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
