# REQUIRES: x86
# RUN: split-file %s %t.dir && cd %t.dir && \
# RUN:   %python -c "import os,sys; [os.remove(p) for p in sys.argv[1:] if os.path.exists(p)]" %t.llilk %t.exe && \
# RUN:   llvm-mc -filetype=obj -triple=x86_64-windows-msvc foo.s -o foo.obj && \
# RUN:   llvm-mc -filetype=obj -triple=x86_64-windows-msvc bar.s -o bar.obj && \
# RUN:   llvm-lib -machine:amd64 -out:test.lib foo.obj bar.obj && \
# RUN:   llvm-mc -filetype=obj -triple=x86_64-windows-msvc main.s -o main.obj && \
# RUN:   env LLD_IN_TEST=1 lld-link -entry:main -subsystem:console -incremental -opt:noref,noicf -ilk:%t.llilk -out:%t.exe main.obj /wholearchive:test.lib && \
# RUN:   %python check_offsets.py %t.llilk test.lib

#--- check_offsets.py
import struct
import sys

state_path, archive_path = sys.argv[1:3]
data = open(state_path, "rb").read()
header = struct.unpack_from("<8sIHHHH34Q", data, 0)
if header[0] != b"LLILK64\0":
    raise SystemExit("unexpected state magic")
fields = header[6:]
input_table_offset = fields[10]
input_count = fields[11]
string_table_offset = fields[32]
string_table_size = fields[33]
strings = data[string_table_offset:string_table_offset + string_table_size]

def load_string(offset):
    end = strings.index(b"\0", offset)
    return strings[offset:end].decode()

state_offsets = []
for i in range(input_count):
    _name_offset, parent_offset, archive_offset, _content_hash, _size = (
        struct.unpack_from("<5Q", data, input_table_offset + i * struct.calcsize("<5Q"))
    )
    if load_string(parent_offset) == "test.lib":
        state_offsets.append(archive_offset)

archive_offsets = []
archive = open(archive_path, "rb").read()
if not archive.startswith(b"!<arch>\n"):
    raise SystemExit("unexpected archive magic")

offset = len(b"!<arch>\n")
while offset + 60 <= len(archive):
    name = archive[offset : offset + 16].decode("ascii").rstrip()
    size = int(archive[offset + 48 : offset + 58].decode("ascii").strip())
    if name not in ("/", "//"):
        archive_offsets.append(offset)
    offset += 60 + size
    if offset & 1:
        offset += 1

state_offsets.sort()
archive_offsets.sort()
if state_offsets != archive_offsets:
    raise SystemExit(
        "persisted archive offsets %r did not match archive member offsets %r"
        % (state_offsets, archive_offsets)
    )

#--- main.s
.section .text,"xr",one_only,main
.globl main
main:
  xorl %eax, %eax
  retq

#--- foo.s
.section .text$foo,"xr",one_only,foo
.globl foo
foo:
  retq

#--- bar.s
.section .text$bar,"xr",one_only,bar
.globl bar
bar:
  retq
