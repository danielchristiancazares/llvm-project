# REQUIRES: x86
# RUN: split-file %s %t.dir && cd %t.dir && \
# RUN:   %python -c "import os,sys; [os.remove(p) for p in sys.argv[1:] if os.path.exists(p)]" %t.llilk %t.exe %t.pdb before.txt after.txt %t.out && \
# RUN:   llvm-mc -filetype=obj -triple=x86_64-windows-msvc holder.s -o holder.obj && \
# RUN:   llvm-mc -filetype=obj -triple=x86_64-windows-msvc callee1.s -o callee.obj && \
# RUN:   env LLD_IN_TEST=1 lld-link -entry:main -subsystem:console -debug:symtab -incremental -opt:noref,noicf -ilk:%t.llilk -out:%t.exe holder.obj callee.obj && \
# RUN:   llvm-objdump -s --section=.data %t.exe > before.txt && \
# RUN:   llvm-mc -filetype=obj -triple=x86_64-windows-msvc callee2.s -o callee.obj && \
# RUN:   echo SECOND > %t.out && \
# RUN:   env LLD_IN_TEST=1 lld-link -entry:main -subsystem:console -debug:symtab -incremental -opt:noref,noicf -ilk:%t.llilk -out:%t.exe -verbose holder.obj callee.obj >> %t.out 2>&1 && \
# RUN:   llvm-objdump -s --section=.data %t.exe > after.txt && \
# RUN:   %python -c "import pathlib,sys; sys.exit(0 if pathlib.Path('before.txt').read_text()!=pathlib.Path('after.txt').read_text() else 1)" && \
# RUN:   FileCheck %s < %t.out

# CHECK: SECOND
# CHECK: incremental: installed legacy redirect .text

#--- holder.s
.section .text,"xr",one_only,main
.globl main
main:
  xorl %eax, %eax
  retq

.section .data,"dw",one_only,callee_ptr
.globl callee_ptr
callee_ptr:
  .quad callee

#--- callee1.s
.section .text,"xr",one_only,callee
.globl callee
callee:
  movl $1, %eax
  retq

#--- callee2.s
.section .text,"xr",one_only,callee
.globl callee
callee:
  movl $1, %eax
  .rept 32
  nop
  .endr
  retq
