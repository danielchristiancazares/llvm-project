# REQUIRES: x86
# RUN: split-file %s %t.dir && cd %t.dir && \
# RUN:   %python -c "import os,sys; [os.remove(p) for p in sys.argv[1:] if os.path.exists(p)]" %t.llilk %t.exe %t.out && \
# RUN:   llvm-mc -filetype=obj -triple=x86_64-windows-msvc main.s -o main.obj && \
# RUN:   env LLD_IN_TEST=1 lld-link -entry:main -subsystem:console -debug:symtab -incremental -opt:noref,noicf -ilk:%t.llilk -out:%t.exe main.obj %S/Inputs/resource.res && \
# RUN:   echo CHANGED > %t.out && \
# RUN:   env LLD_IN_TEST=1 lld-link -entry:main -subsystem:console -debug:symtab -incremental -opt:noref,noicf -ilk:%t.llilk -out:%t.exe -verbose main.obj %S/Inputs/id.res >> %t.out 2>&1 && \
# RUN:   echo REUSE >> %t.out && \
# RUN:   env LLD_IN_TEST=1 lld-link -entry:main -subsystem:console -debug:symtab -incremental -opt:noref,noicf -ilk:%t.llilk -out:%t.exe -verbose main.obj %S/Inputs/id.res >> %t.out 2>&1 && \
# RUN:   FileCheck %s < %t.out

# CHECK: CHANGED
# CHECK: incremental: fallback: LayoutChanged
# CHECK: incremental: detail: resource or manifest inputs changed
# CHECK: REUSE
# CHECK: incremental: using state
# CHECK: incremental: exact-layout reuse active

#--- main.s
.text
.globl main
main:
  xorl %eax, %eax
  retq

