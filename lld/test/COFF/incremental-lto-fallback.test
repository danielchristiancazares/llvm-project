# REQUIRES: x86
# RUN: split-file %s %t.dir && cd %t.dir
# RUN: %python -c "import os, sys; [os.remove(p) for p in sys.argv[1:] if os.path.exists(p)]" %t.llilk %t.exe
# RUN: llvm-as main.ll -o main.bc
# RUN: lld-link -entry:main -subsystem:console -incremental -opt:noref,noicf -ilk:%t.llilk -out:%t.exe -verbose main.bc 2>&1 | FileCheck %s --check-prefix=LTO

# LTO: incremental: fallback: LtoInput

#--- main.ll
target triple = "x86_64-pc-windows-msvc"
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n8:16:32:64-S128"

define i32 @main() {
entry:
  ret i32 0
}
