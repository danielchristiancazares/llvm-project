# REQUIRES: x86
# RUN: split-file %s %t.dir && cd %t.dir
# RUN: %python -c "import os, sys; [os.remove(p) for p in sys.argv[1:] if os.path.exists(p)]" %t.llilk %t.exe %t.pdb before.txt after.txt
# RUN: llvm-mc -filetype=obj -triple=x86_64-windows-msvc main1.s -o main.obj
# RUN: llvm-mc -filetype=obj -triple=x86_64-windows-msvc helper.s -o helper.obj
# RUN: env LLD_IN_TEST=1 lld-link -entry:main -subsystem:console -debug:symtab -incremental -opt:noref,noicf -ilk:%t.llilk -out:%t.exe main.obj helper.obj
# RUN: llvm-readobj --symbols %t.exe > before.txt
# RUN: llvm-mc -filetype=obj -triple=x86_64-windows-msvc main2.s -o main.obj
# RUN: env LLD_IN_TEST=1 lld-link -entry:main -subsystem:console -debug:symtab -incremental -opt:noref,noicf -ilk:%t.llilk -out:%t.exe -verbose main.obj helper.obj 2>&1 | FileCheck %s --check-prefix=REUSE
# RUN: llvm-readobj --symbols %t.exe > after.txt
# RUN: cmd /c fc before.txt after.txt > nul

# REUSE: incremental: using state
# REUSE: incremental: exact-layout reuse active
# REUSE: incremental: reuse counters: reused-chunks=1 rewritten-chunks=3 baseline-skip=no
# REUSE-NOT: incremental: soft-config metadata changed; rebuilding PDB metadata

#--- main1.s
.section .text,"xr",one_only,main
.globl main
main:
  movl $1, %eax
  retq

#--- main2.s
.section .text,"xr",one_only,main
.globl main
main:
  movl $9, %eax
  retq

#--- helper.s
.section .text,"xr",one_only,helper
.globl helper
helper:
  movl $7, %eax
  retq
