# REQUIRES: x86
# RUN: split-file %s %t.dir && cd %t.dir && \
# RUN:   %python -c "import os,sys; [os.remove(p) for p in sys.argv[1:] if os.path.exists(p)]" %t.llilk %t.exe %t.pdb %t.out before.txt after.txt before-rdata.txt after-rdata.txt && \
# RUN:   llvm-mc -filetype=obj -triple=x86_64-windows-msvc v1.s -o main.obj && \
# RUN:   env LLD_IN_TEST=1 lld-link -entry:main -subsystem:console -debug:symtab -incremental -opt:noref,noicf -ilk:%t.llilk -out:%t.exe main.obj && \
# RUN:   llvm-readobj --sections %t.exe > before.txt && \
# RUN:   %python -c "import re; text=open('before.txt').read(); m=re.search(r'Name: \\.rdata.*?VirtualAddress: 0x([0-9A-Fa-f]+)', text, re.S); assert m; open('before-rdata.txt','w').write(m.group(1))" && \
# RUN:   llvm-mc -filetype=obj -triple=x86_64-windows-msvc v2.s -o main.obj && \
# RUN:   echo SECOND > %t.out && \
# RUN:   env LLD_IN_TEST=1 lld-link -entry:main -subsystem:console -debug:symtab -incremental -opt:noref,noicf -ilk:%t.llilk -out:%t.exe -verbose main.obj >> %t.out 2>&1 && \
# RUN:   llvm-readobj --sections %t.exe > after.txt && \
# RUN:   %python -c "import re; text=open('after.txt').read(); m=re.search(r'Name: \\.rdata.*?VirtualAddress: 0x([0-9A-Fa-f]+)', text, re.S); assert m; open('after-rdata.txt','w').write(m.group(1))" && \
# RUN:   cmd /c fc before-rdata.txt after-rdata.txt > nul && \
# RUN:   FileCheck %s < %t.out && \
# RUN:   FileCheck %s --check-prefix=SECTIONS < after.txt

# CHECK: SECOND
# CHECK: incremental: fallback: LayoutChanged
# CHECK: incremental: detail: resolved symbol count changed

# SECTIONS: Name: .rdata

#--- v1.s
.section .text,"xr",one_only,main
.globl main
main:
  xorl %eax, %eax
  retq

.section .data,"dw",one_only,payload
.globl payload
payload:
  .quad 1

.section .rdata,"dr",one_only,constant
.globl constant
constant:
  .quad 2

#--- v2.s
.section .text,"xr",one_only,main
.globl main
main:
  xorl %eax, %eax
  retq

.section .rdata,"dr",one_only,constant
.globl constant
constant:
  .quad 2
