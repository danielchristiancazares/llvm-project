# REQUIRES: x86
# RUN: split-file %s %t.dir && cd %t.dir && \
# RUN:   %python -c "import os,sys; [os.remove(p) for p in sys.argv[1:] if os.path.exists(p)]" %t.llilk %t.exe one.pdb two.pdb && \
# RUN:   llvm-mc -filetype=obj -triple=x86_64-windows-msvc main.s -o main.obj && \
# RUN:   lld-link -entry:main -subsystem:console -debug -pdb:one.pdb -incremental -opt:noref,noicf -ilk:%t.llilk -out:%t.exe main.obj && \
# RUN:   lld-link -entry:main -subsystem:console -debug -pdb:two.pdb -incremental -opt:noref,noicf -ilk:%t.llilk -out:%t.exe -verbose main.obj 2>&1 | FileCheck %s
# RUN:   %python -c "import pathlib; import sys; sys.exit(0 if pathlib.Path('two.pdb').is_file() else 1)"

# CHECK: incremental: using state
# CHECK: incremental: exact-layout reuse active

#--- main.s
.text
.globl main
main:
  movl $3, %eax
  retq
